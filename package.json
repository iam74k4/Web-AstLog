{
  "name": "astlog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-ids.mjs && wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply astlog --local",
    "db:migrate": "node scripts/check-ids.mjs && wrangler d1 migrations apply astlog --remote",
    "db:seed:local": "node scripts/seed-local.mjs",
    "site:touch": "node scripts/touch-site.mjs --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:gallery": "node scripts/check-gallery.mjs",
    "check:fit": "node scripts/check-fit.mjs",
    "check:restore": "node scripts/check-restore.mjs",
    "check:ids": "node scripts/check-ids.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "check:media-restore": "node scripts/check-media-restore.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "zod": "4.6.7"
  }
}
