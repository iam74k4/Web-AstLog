{
  "name": "astlog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/check-ids.mjs && wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply astlog --local",
    "db:migrate": "node scripts/check-ids.mjs && wrangler d1 migrations apply astlog --remote",
    "db:seed:local": "wrangler d1 execute astlog --local --file=./seed.sql && node scripts/touch-site.mjs --local",
    "site:touch": "node scripts/touch-site.mjs --remote",
    "db:seed:remote:destroys-prod": "node scripts/seed-remote.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fit": "node scripts/check-fit.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:restore": "node scripts/check-restore.mjs",
    "check:ids": "node scripts/check-ids.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8"
  }
}
